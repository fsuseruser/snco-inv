# Postgres connection string (Vercel: Storage → Neon → it is added automatically as DATABASE_URL)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# First admin account, created on first deploy. You will be asked to change the password on first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# Time zone used for dates and "today" counts
APP_TIMEZONE=Asia/Dubai
